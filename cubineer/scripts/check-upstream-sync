#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
python="${PYTHON:-python3}"
target_dir="${CARGO_TARGET_DIR:-$repo_root/codex-rs/target}"
profile="${CUBINEER_CARGO_PROFILE:-dev-small}"
export RUST_MIN_STACK="${RUST_MIN_STACK:-8388608}"

run_stage() {
  local name="$1"
  shift
  local log
  log="$(mktemp)"
  set +e
  "$@" 2>&1 | tee "$log"
  local status="${PIPESTATUS[0]}"
  set -e
  if ((status != 0)) && [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    while IFS= read -r line; do
      line="${line//'%'/'%25'}"
      printf '::error title=%s failed::%s\n' "$name" "$line"
    done < <(grep -E '(^error:|^FAILED |^ERROR |^E +|AssertionError|No space left|failed to|could not compile|signal:|panicked|fatal runtime error|stack overflow|[0-9]+ failed)' "$log" | tail -20)
  fi
  rm -f "$log"
  return "$status"
}

cd "$repo_root/codex-rs"
run_stage "Kernel tests" cargo test --locked --profile "$profile" \
  -p codex-kernel-search -p codex-kernel
run_stage "Controller-child test" cargo test --locked --profile "$profile" -p codex-core \
  controller_children_share_budget_but_not_history_or_execution_capacity
run_stage "Cubineer build" cargo build --locked --profile "$profile" \
  -p codex-cli -p codex-kernel

cd "$repo_root"
CUBINEER_TEST_BINARY="$target_dir/$profile/codex-kernel" \
CUBINEER_TEST_MAIN_BINARY="$target_dir/$profile/codex" \
  run_stage "Python tests" "$python" -m pytest cubineer/tests
